# Aegis .clang-tidy — Static analysis rules.
# Enforces the project's laws (Rules 36-76, B.1-B.6, A.1-A.5, D.1-D.10)
# at the linter level where possible.

---
# All enabled checks. Start from a wide set, then disable what doesn't fit.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -readability-named-parameter,
  -modernize-use-nodiscard,
  -bugprone-easily-swappable-parameters,
  -misc-non-private-member-variables-in-classes,
  -cppcoreguidelines-special-member-functions,
  -cppcoreguidelines-pro-type-member-init,
  -performance-unnecessary-value-param,
  -readability-else-after-return

# All warnings as errors (Rule B.1 + Rules 62 + 73 — no "minor" defects).
WarningsAsErrors: '*'

# Only check our own headers; skip system + third-party.
HeaderFilterRegex: '^(?!build/|.*stdlib/|.*bits/).*$'

CheckOptions:
  # ---- Rule 61 / D.1 — magic numbers ----
  # Magic numbers > 2 in pass/backend logic are forbidden. Allow 0, 1,
  # and small enum-style numbers but flag thresholds, budgets, etc.
  - key:    readability-magic-numbers.IgnoredIntegerValues
    value:  '0;1;-1;2;-2'
  - key:    readability-magic-numbers.IgnoredFloatingPointValues
    value:  '0.0;1.0;-1.0'

  # ---- Rule 51 — bitmask flags ----
  - key:    cppcoreguidelines-pro-type-union-access.ResultListAll
    value:  0

  # ---- Rule 60 — std::expected over if chains ----
  - key:    modernize-use-nodiscard.Reason
    value:  'Rule 60 — success path should be linear.'

  # ---- Rule 70/71 — documentation ----
  - key:    readability-function-cognitive-complexity.Threshold
    value:  30

  # ---- Rule 73 — robustness ----
  - key:    bugprone-branch-clone.ImmuneFromMacro
    value:  0

  # ---- Rule 72 — no lazy logic ----
  - key:    performance-inefficient-string-concatenation.WarnOnConcatInLoop
    value:  1
  - key:    performance-inefficient-vector-operation.WarnOnOptimised
    value:  1

  # ---- Rule D.4 — no lazy data structures ----
  - key:    performance-unnecessary-copy-initialization.WarnOnConstParam
    value:  1

  # ---- Rule D.9 — untested code paths ----
  - key:    bugprone-unhandled-exception-at-expr.AllowThrow
    value:  0
